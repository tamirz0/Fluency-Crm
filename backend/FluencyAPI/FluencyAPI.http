@FluencyAPI_HostAddress = http://localhost:5169

# Reemplazar 0 por el ID de una empresa de prueba propia, nunca por una empresa real.
@empresaPatchId = 0

# Reemplazar 0 únicamente por IDs de registros de prueba propios.
@contactoPatchId = 0
@oportunidadPatchId = 0

### PATCH Contacto: reemplazar teléfono y borrar cargo
PATCH {{FluencyAPI_HostAddress}}/Contacto/ModificarContacto/{{contactoPatchId}}
Content-Type: application/json

{ "telefono": "1144445555", "cargo": null }

### PATCH Contacto: borrar empresa (400 si tiene oportunidades; 200 si no tiene)
PATCH {{FluencyAPI_HostAddress}}/Contacto/ModificarContacto/{{contactoPatchId}}
Content-Type: application/json

{ "idEmpresa": null }

### PATCH Contacto: obligatorio no borrable (400)
PATCH {{FluencyAPI_HostAddress}}/Contacto/ModificarContacto/{{contactoPatchId}}
Content-Type: application/json

{ "nombre": null }

### PATCH Oportunidad: borrar fecha estimada y reemplazar observaciones
PATCH {{FluencyAPI_HostAddress}}/Oportunidades/ModificarOportunidad/{{oportunidadPatchId}}
Content-Type: application/json

{ "fechaEstimadaCierre": null, "observaciones": "Seguimiento actualizado" }

### PATCH Oportunidad: conservar solo contacto (400 si no hay contacto)
PATCH {{FluencyAPI_HostAddress}}/Oportunidades/ModificarOportunidad/{{oportunidadPatchId}}
Content-Type: application/json

{ "idEmpresa": null }

### PATCH Oportunidad: no puede quedar sin empresa ni contacto (400 con recurso existente)
PATCH {{FluencyAPI_HostAddress}}/Oportunidades/ModificarOportunidad/{{oportunidadPatchId}}
Content-Type: application/json

{ "idEmpresa": null, "idContacto": null, "titulo": "NO GUARDAR" }

### POST Oportunidad: null conserva (comparación con PATCH)
POST {{FluencyAPI_HostAddress}}/Oportunidades/ModificarOportunidad/{{oportunidadPatchId}}
Content-Type: application/json

{ "fechaEstimadaCierre": null }

### PATCH Empresa: cambiar teléfono y borrar correo (200; 404 con ID 0)
PATCH {{FluencyAPI_HostAddress}}/Empresa/ModificarEmpresa/{{empresaPatchId}}
Content-Type: application/json

{
  "telefono": "1144445555",
  "correo": null
}

### Consultar el resultado y comprobar que el resto se conserva
GET {{FluencyAPI_HostAddress}}/Empresa/DatosEmpresa/{{empresaPatchId}}
Accept: application/json

### POST compatible: correo null conserva el correo guardado
POST {{FluencyAPI_HostAddress}}/Empresa/ModificarEmpresa/{{empresaPatchId}}
Content-Type: application/json

{ "correo": null }

### PATCH vacío: conserva todos los campos
PATCH {{FluencyAPI_HostAddress}}/Empresa/ModificarEmpresa/{{empresaPatchId}}
Content-Type: application/json

{}

### PATCH rechazado: razón social no se puede borrar (400, no cambia teléfono)
PATCH {{FluencyAPI_HostAddress}}/Empresa/ModificarEmpresa/{{empresaPatchId}}
Content-Type: application/json

{ "razonSocial": null, "telefono": "NO GUARDAR" }

### PATCH rechazado: campo fuera de la lista permitida (400)
PATCH {{FluencyAPI_HostAddress}}/Empresa/ModificarEmpresa/{{empresaPatchId}}
Content-Type: application/json

{ "id": 123 }

### PATCH rechazado: referencia inexistente (400 con empresa de prueba existente)
PATCH {{FluencyAPI_HostAddress}}/Empresa/ModificarEmpresa/{{empresaPatchId}}
Content-Type: application/json

{ "idEstado": -1, "telefono": null }

###

### Estados de cliente (200; [] si el catálogo está vacío)
GET {{FluencyAPI_HostAddress}}/EstadosCliente/ListadoEstadosCliente
Accept: application/json

### Orígenes comerciales (200; [] si el catálogo está vacío)
GET {{FluencyAPI_HostAddress}}/OrigenesComerciales/ListadoOrigenesComerciales
Accept: application/json

### Etapas comerciales, sin oportunidades (200; [] si el catálogo está vacío)
GET {{FluencyAPI_HostAddress}}/EtapasComerciales/ListadoEtapasComerciales
Accept: application/json

###

### Servicios activos para seleccionar en una oportunidad (200; [] si no hay activos)
GET {{FluencyAPI_HostAddress}}/Servicios/ListadoServicios
Accept: application/json

###

GET {{FluencyAPI_HostAddress}}/weatherforecast/
Accept: application/json

###

### Alta de oportunidad
POST {{FluencyAPI_HostAddress}}/Oportunidades/AltaOportunidad
Content-Type: application/json

{
  "titulo": "Curso B1 para Acme S.A.",
  "idUsuario": 1,
  "idEtapa": 1,
  "idEmpresa": 1,
  "idServicio": 1,
  "idOrigen": 1
}

###

### Oportunidades agrupadas por etapa (embudo comercial)
GET {{FluencyAPI_HostAddress}}/Oportunidades/OportunidadesPorEtapa
Accept: application/json

###

### Mover una oportunidad a otra etapa
POST {{FluencyAPI_HostAddress}}/Oportunidades/UpdateEtapaOportunidad/1
Content-Type: application/json

{
  "idNuevaEtapa": 2,
  "idUsuario": 1,
  "observacion": "Aprobó el examen de nivelación"
}

###

### Datos de una oportunidad
GET {{FluencyAPI_HostAddress}}/Oportunidades/DatosOportunidad/1
Accept: application/json

###

### Modificar una oportunidad
POST {{FluencyAPI_HostAddress}}/Oportunidades/ModificarOportunidad/1
Content-Type: application/json

{
  "observaciones": "Cliente pidió una cotización actualizada"
}

